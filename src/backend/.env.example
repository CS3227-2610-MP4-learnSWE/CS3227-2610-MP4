# learnSWE backend settings. Copy this file to `.env` (it is ignored by Git) and keep real secrets out of Git.
# Lines you can leave unchanged for a local setup are marked "leave as is".

# --- Database (leave as is for the PostgreSQL started by `docker compose up -d postgres`) ---
DATABASE_URL=postgresql+psycopg://learnswe:learnswe-local-only@127.0.0.1:5433/learnswe

# "development" for your own computer over plain http; "production" for a real deployment (needs https).
APP_ENV=development

# --- Sign-in sessions (leave as is for a local setup) ---
SESSION_COOKIE_NAME=learnswe_session
# Must be true in production (https). Keep false for plain http on your own computer.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=43200
# Every address the browser uses to open the app. Add yours here, or sign-in fails with a 403.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HEADERS=false
# Optional built frontend directory. Leave unset for API-only local development.
# The production Docker image sets this to /app/frontend-dist.
# FRONTEND_DIST_DIR=
# Hosting platform port; the production entrypoint defaults to 8000 when unset.
# PORT=8000
AUTH_LOGIN_MAX_FAILURES_PER_EMAIL=5
AUTH_LOGIN_MAX_FAILURES_PER_IP=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_SIGNUP_MAX_PER_IP=10
AUTH_SIGNUP_WINDOW_SECONDS=3600

# --- Starting accounts, created by `python -m auth.seed` ---
# Fill in all six lines: a sign-in email and a password for each role. Passwords need 10 to 128
# characters, must not be a common password and must not be the email. The README lists example values
# you can use to try the app on your own computer. Replace them with your own before anyone else can
# reach the app. Never commit real passwords.
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- AI features (optional) ---
# The study companion, AI draft notes and AI practice questions, feedback analysis and answer grading
# call the SoC LLM (an OpenAI-compatible service). Without these three values those features say they
# are unavailable and everything else works. Never commit the key.
SOCLAAS_BASE_URL=
SOCLAAS_API_KEY=
SOCLAAS_MODEL=

# Export these values before running migrations and the API.
DATABASE_URL=postgresql+psycopg://learnswe:learnswe-local-only@127.0.0.1:5433/learnswe_db_files
APP_ENV=development
ALLOW_DEMO_IDENTITY=true

# Copy to .env (ignored by git) and fill in. Never commit real values.
# Names only: the SoC LLM, OpenAI-compatible. Needed for companion and teacher generation.
SOCLAAS_BASE_URL=
SOCLAAS_API_KEY=
SOCLAAS_MODEL=

# Authentication (SHR-01). Names with safe local defaults; never commit real values.
SESSION_COOKIE_NAME=learnswe_session
# Must be true when APP_ENV=production; false only for plain-http local development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=43200
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HEADERS=false
AUTH_LOGIN_MAX_FAILURES_PER_EMAIL=5
AUTH_LOGIN_MAX_FAILURES_PER_IP=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_SIGNUP_MAX_PER_IP=10
AUTH_SIGNUP_WINDOW_SECONDS=3600

# Seed accounts for `uv run python -m auth.seed`. Set locally, never commit.
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

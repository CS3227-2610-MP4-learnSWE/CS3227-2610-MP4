# learnSWE frontend settings. Copy this file to `.env` (ignored by Git).

# The port the backend listens on. The dev server forwards /api requests to it. Leave as is unless you
# start the backend on another port.
API_PORT=8000

# "false" hides the "explore without signing in" shortcut on the login page, so everyone must sign in.
# Set it to "true" only if you want visitors to be able to look at sample screens without an account.
VITE_ENABLE_DEMO_ACCESS=false
